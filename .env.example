# Discord Developer Portal > Application > Bot > Token
DISCORD_BOT_TOKEN=
# General Information > Application ID
DISCORD_APPLICATION_ID=
# Servidor de teste para registrar comandos imediatamente. Vazio = global.
DISCORD_GUILD_ID=

# Projeto Google Cloud com faturamento, Vertex AI e acesso ao modelo habilitados.
GOOGLE_CLOUD_PROJECT=seu-projeto-google
VERTEX_LOCATION=global
VERTEX_MODEL=google/gemini-4-argon
# Nano Banana (Gemini Image) no Vertex. global costuma ser a região certa para imagem.
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_LOCATION=global
# Gemini Omni Flash (vídeo rápido). Mesma conta de serviço do Vertex.
VIDEO_MODEL=gemini-omni-1.1-flash-preview
VIDEO_LOCATION=global
VIDEO_TIMEOUT_SECONDS=180
# Música com Lyria 3 Pro (MP3 com voz ou instrumental). Mesma conta do Vertex.
# Use lyria-3-clip-preview para trechos de 30 segundos.
MUSIC_MODEL=lyria-3-pro-preview
MUSIC_LOCATION=global
MUSIC_TIMEOUT_SECONDS=300
# Pesquisa Google (Grounding) para o Gemini consultar a web. Mesma conta do Vertex.
SEARCH_MODEL=gemini-2.5-flash
SEARCH_LOCATION=global
# Opcional: arquivo JSON de conta de serviço, FORA do projeto.
# Vazio usa ADC local ou a conta de serviço vinculada à VM/Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=

PORT=8080
DATABASE_PATH=./data/bot.sqlite
MAX_CONCURRENT=3
USER_DAILY_REQUESTS=30
GLOBAL_DAILY_REQUESTS=200
USER_COOLDOWN_SECONDS=10
# Teto para permitir códigos e respostas completas; não obriga respostas longas.
MAX_OUTPUT_TOKENS=8192
MODEL_TIMEOUT_SECONDS=90
MODEL_TEMPERATURE=0.5
# Gemini 4 Argon usa raciocínio em vez de MODEL_TEMPERATURE: low, medium ou high.
MODEL_REASONING_EFFORT=low
MAX_TOOL_ROUNDS=6
MAX_TOOL_CALLS=16
# Recursos opcionais; false desativa a integração e suas ferramentas.
ENABLE_IMAGES=true
ENABLE_VIDEOS=true
ENABLE_MUSIC=true
ENABLE_SEARCH=true
ENABLE_SERVER_TOOLS=true
# Habilite também no Developer Portal para ler respostas sem menção no servidor.
MESSAGE_CONTENT_INTENT=false
HISTORY_PAIRS=8
# Espaço para retomar e corrigir arquivos gerados no histórico.
MAX_CONTEXT_CHARS=64000
HISTORY_TTL_HOURS=24
# IDs separados por vírgula. Vazio = qualquer servidor/usuário/canal.
ALLOWED_GUILD_IDS=
ALLOWED_USER_IDS=
ALLOWED_CHANNEL_IDS=
# Opcional: sem esta variável, usa a personalidade doce e acolhedora de src/config.py.
# SYSTEM_PROMPT substitui o texto padrão inteiro, incluindo instruções de ferramentas.
# Use uma única linha e aspas se incluir #.
